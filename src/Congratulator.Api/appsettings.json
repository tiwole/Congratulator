{
  "YandexS3": {
    "AccessKey": "access key",
    "SecretKey": "secret key",
    "BucketName": "bucket name",
    "ServiceURL": "https://storage.yandexcloud.net",
    "Region": "region"
  },
  "ConnectionStrings": {
    "IdentityConnectionString": "connection string"
  },
  "MigrateDbOnStartup": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}