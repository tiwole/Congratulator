@using Congratulator.WebAssembly.Components.Navbar

@inherits LayoutComponentBase

<Navbar Title="Congratulator" Items="@NavItems" />

<main>
    <article class="content">
        @Body
    </article>
</main>

<LumexThemeProvider />

<LumexToastProvider RichColors="@true"/>

@code {
    private static readonly List<NavbarItem> NavItems =
    [
        new("Home", Routes.Pages.Home, "ri-home-fill", NavLinkMatch.All),
        new("All", Routes.Pages.All, "ri-list-check-2"),
        new("Chart", Routes.Pages.Chart, "ri-bar-chart-fill"),
        new("Testing", Routes.Pages.Testing, "ri-test-tube-fill"),
        new("Icons", Routes.Pages.UiKitIcons, "ri-remixicon-line"),
    ];
}