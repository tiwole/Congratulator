@using Congratulator.WebAssembly.Components.PersonFormModal
@using Congratulator.WebAssembly.Components.PersonModal
@using LumexUI.Common
@using LumexUI.Shared.Icons
@namespace Congratulator.WebAssembly.Pages.All

@inherits BasePageComponent

@attribute [Route(Routes.Pages.All)]

<PersonModal @ref="_personModal" />
<PersonFormModal @ref="_personFormModal" OnPersonSaved="@OnPersonSavedAsync" />

<div class="all-page">
    <header class="all-header">
        <div>
            <div class="all-directory-label mono">DIRECTORY</div>
            <h1 class="all-title">All people</h1>
            <p class="all-subtitle">
                @if (IsLoading)
                {
                    <LumexSkeleton Class="skel-subtitle"/>
                }
                else if (_totalCount > 0)
                {
                    <span>@_totalCount people</span>
                }
            </p>
        </div>
        <LumexButton Color="@ThemeColor.Primary" Size="Size.Medium" OnClick="@(() => _personFormModal.OpenCreate())">
            <i class="ri-add-line"></i>
            Add person
        </LumexButton>
    </header>
    <div class="person-page-container">
        <div class="person-grid">
            <LumexDataGrid @ref="@_grid"
                           @key="@_gridKey"
                           DataSource="@PeopleProvider"
                           Loading="@IsLoading"
                           Hoverable="@true"
                           OnRowClick="@(async (DataGridRowClickEventArgs<PersonModel> v) => await OnRowClickHandler(v))">
                <LoadingContent>
                    <LumexSpinner Size="@Size.Small" Class="p-3"/>
                    Fetching data...
                </LoadingContent>
                <ToolbarContent>
                    <div class="grid-toolbar">
                        <LumexTextbox Placeholder="Search by name..."
                                      Behavior="@InputBehavior.OnInput"
                                      @bind-Value="@_nameFilterInput"
                                      @onkeydown="@KeyPressHandler">
                            <StartContent>
                                <SearchIcon Size="20"/>
                            </StartContent>
                        </LumexTextbox>

                        <LumexButton OnClick="@SearchClick">
                            Search
                        </LumexButton>

                        <LumexDropdown OpenChanged="@(value => OnDropdownStateChanged(value))">
                            <LumexDropdownTrigger>
                                <LumexButton Variant="@Variant.Flat" Style="width: 10.5rem">
                                    <div class="dropdown-button-container">
                                        <span>@GetDropdownLabel(ActiveRelationshipTypes.Count)</span>
                                        <i class="@(_isDropdownOpened ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
                                    </div>
                                </LumexButton>
                            </LumexDropdownTrigger>
                            <LumexDropdownMenu>
                                <LumexDropdownItem Class="no-hover">
                                    <LumexCheckboxGroup>
                                        @foreach (var type in AvailableRelationshipTypes)
                                        {
                                            var t = type;
                                            <LumexCheckbox Value="@ActiveRelationshipTypes.Contains(t)"
                                                           Color="@GetRelationshipColor(t)"
                                                           ValueChanged="@(() => ToggleRelationship(t))">
                                                @t
                                            </LumexCheckbox>
                                        }
                                    </LumexCheckboxGroup>
                                </LumexDropdownItem>
                            </LumexDropdownMenu>
                        </LumexDropdown>

                        <LumexButton OnClick="@OnResetClick" IconOnly="@true" Variant="Variant.Flat">
                            <i class="ri-refresh-line grid-icon @(_isRefreshSpinning ? "grid-icon--spin" : "")"></i>
                        </LumexButton>
                    </div>
                </ToolbarContent>
                <ChildContent>
                    <div class="grid-rows">
                        <TemplateColumn Title="Name" Sortable="@true"
                                        SortBy="@(SortBuilder<PersonModel>.ByAscending(p => p.FirstName))">
                            <div class="name-cell">
                                <LumexAvatar Src="@context.PhotoPath"
                                             Size="Size.Small"
                                             Bordered="@true"
                                             Color="@GetRelationshipColor(context.RelationshipType)"/>
                                <span>@context.FirstName @context.LastName</span>
                            </div>
                        </TemplateColumn>
                        <TemplateColumn Title="Birth Date" Sortable="@true"
                                        SortBy="@(SortBuilder<PersonModel>.ByAscending(p => p.BirthDate))">
                            @context.BirthDate.ToString("dd.MM.yyyy")
                        </TemplateColumn>
                        <TemplateColumn Title="Age" Sortable="@true"
                                        SortBy="@(SortBuilder<PersonModel>.ByAscending(p => p.Age))">
                            @context.Age @GetAgeWord(context.Age)
                        </TemplateColumn>
                        <TemplateColumn Title="Days until birthday">
                            @GetDaysCell(context)
                        </TemplateColumn>
                        <TemplateColumn Title="Relationship">
                            <LumexChip Size="Size.Small"
                                       Color="@GetRelationshipColor(context.RelationshipType)"
                                       Variant="ChipVariant.Outlined">
                                @context.RelationshipType
                            </LumexChip>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Align="@Align.Center">
                            <div class="grid-actions">
                                <div @onclick:stopPropagation="true">
                                    <LumexButton IconOnly="@true"
                                                 Size="@Size.Small"
                                                 Variant="@Variant.Flat"
                                                 OnClick="@(() => OnEditClick(context))">
                                        <i class="ri-edit-line actions-icon"></i>
                                    </LumexButton>
                                </div>
                                <div @onclick:stopPropagation="true">
                                    <LumexButton IconOnly="@true"
                                                 Size="@Size.Small"
                                                 Variant="@Variant.Flat"
                                                 OnClick="@(() => OnDeleteClick(context))">
                                        <i class="ri-delete-bin-line actions-icon"></i>
                                    </LumexButton>
                                </div>
                            </div>
                        </TemplateColumn>
                    </div>
                </ChildContent>
            </LumexDataGrid>

            @if (_totalCount == 0 && !IsLoading)
            {
                <div class="empty-state">
                    <span class="empty-state-emoji">@_currentEmoji</span>
                    <span>No results found</span>
                </div>
            }

            @if (_totalPages > 1)
            {
                <Congratulator.WebAssembly.Components.Pagination.Pagination
                    CurrentPage="@_currentPage"
                    TotalPages="@_totalPages"
                    OnPageChanged="@OnPageChangedAsync"/>
            }
        </div>
    </div>
</div>