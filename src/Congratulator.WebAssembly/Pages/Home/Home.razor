@using Congratulator.WebAssembly.Components.BirthdayCard
@using Congratulator.WebAssembly.Components.PersonCard

@inherits BasePageComponent

@attribute [Route(Routes.Pages.Home)]

<PageTitle>Congratulator</PageTitle>

@if (Persons != null)
{
    <div class="space-y-4">
        
        <h3 class="text-2xl font-bold text-center mb-4">Today birthdays:</h3>

        <div class="cards-container">
            @foreach (var person in Persons.People)
            {
                <PersonCard
                    Person="@person"/>
            }
        </div>

        <h3 class="text-2xl font-bold text-center mb-4">Upcoming Birthdays:</h3>

        <div class="cards-container">
            @foreach (var person in Persons.People)
            {
                <PersonCard
                    Person="@person"/>
            }
        </div>
    </div>
}