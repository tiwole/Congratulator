@using System.Globalization
@using Congratulator.WebAssembly.Components.HomeSection
@using Congratulator.WebAssembly.Components.PersonFormModal
@using Congratulator.WebAssembly.Components.PersonModal
@using Congratulator.WebAssembly.Services
@using LumexUI.Common

@inherits BasePageComponent

@attribute [Route(Routes.Pages.Home)]

<PersonModal @ref="_personModal" />
<PersonFormModal @ref="_personFormModal" OnPersonSaved="@RefreshAsync" />

<div class="home-page">
    <header class="home-header">
        <div>
            <div class="home-year-label mono">@DateTimeProvider.Today.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)</div>
            <h1 class="home-title">Upcoming birthdays</h1>
            <p class="home-subtitle">
                @if (_isLoading)
                {
                    <LumexSkeleton Class="skel-subtitle" />
                }
                else if (_totalCount > 0)
                {
                    <span>@_totalCount @(_totalCount == 1 ? "person" : "people")</span>
                    @if (_today.Count > 0)
                    {
                        <span> · </span>
                        <span class="home-subtitle-today">@_today.Count celebrating today</span>
                    }
                }
            </p>
        </div>
        <LumexButton Color="@ThemeColor.Primary" Size="Size.Medium" OnClick="@(() => _personFormModal.OpenCreate())">
            <i class="ri-add-line"></i>
            Add person
        </LumexButton>
    </header>
    @if (!_isLoading && _totalCount == 0)
    {
        <div class="empty-state">
            <span class="empty-state-emoji">@SadEmojis[Random.Shared.Next(0, SadEmojis.Length)]</span>
            <span>No people with upcoming birthdays</span>
        </div>
    }
    else
    {
        <HomeSection Title="Today" People="_today" IsLoading="_isLoading" OnPersonClick="OpenPersonModal" />
        <HomeSection Title="This week" People="_thisWeek" IsLoading="_isLoading" OnPersonClick="OpenPersonModal" />
        <HomeSection Title="This month" People="_thisMonth" IsLoading="_isLoading" OnPersonClick="OpenPersonModal" />
        <HomeSection Title="Upcoming" People="_upcoming" IsLoading="_isLoading" OnPersonClick="OpenPersonModal" />   
    }
</div>

