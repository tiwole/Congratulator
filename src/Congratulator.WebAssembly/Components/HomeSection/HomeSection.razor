@using Congratulator.WebAssembly.Components.PersonCard

@inherits BasePageComponent

@if (People is { Count: > 0 })
{
    var isToday = Title == "Today";
    <section class="home-section">
        <div class="home-section-header">
            <h2 class="home-section-title @(isToday ? "home-section-title--today" : "")">@Title</h2>
            <span class="home-section-count mono">@People.Count.ToString().PadLeft(2, '0')</span>
        </div>
        <LumexDivider />
        <div class="cards-grid">
            @foreach (var person in People)
            {
                <PersonCard @key="person.Id" Person="person" />
            }
        </div>
    </section>
}