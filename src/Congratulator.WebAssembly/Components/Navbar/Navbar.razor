@using Congratulator.WebAssembly.Components.ThemeColorToggle
@inherits BasePageComponent
@using LumexUI.Common
@using LumexUI.Shared.Icons
@inject NavigationManager Nav

<LumexNavbar Bordered="true" Sticky="true">
    <LumexNavbarBrand>
        <div class="navbar-brand" @ref="_brandRef" @onclick="@OnBrandClick">
            <div class="navbar-logo">@char.ToUpper(Title[0])</div>
            <p class="font-bold text-xl">@Title</p>
        </div>
    </LumexNavbarBrand>

    <LumexNavbarContent Align="@Align.Center">
        <LumexTabs Variant="TabVariant.Light">
            @foreach (var item in Items)
            {
                <LumexTab>
                    <TitleContent>
                        <span class="navbar-item" style="position: relative;">
                            <i class="@item.Icon navbar-icon"></i>
                            <span class="page-title">@item.Title</span>
                            <a href="@item.Href"
                               style="position: absolute; inset: 0; z-index: 10;"
                               aria-label="@item.Title">
                            </a>
                        </span>
                    </TitleContent>
                </LumexTab>
            }
        </LumexTabs>
    </LumexNavbarContent>

    <LumexNavbarContent Align="@Align.End">
        <LumexNavbarItem>
            <ThemeColorToggle/>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink @onclick="@(() => OpenInNewTab("https://github.com/tiwole/Congratulator"))"
                       Color="ThemeColor.None">
                <div class="navbar-item">
                    <span style="margin-bottom:0.1rem"><GithubIcon Size="14"/></span>
                    <span class="about-label">About</span>
                </div>
            </LumexLink>
        </LumexNavbarItem>
    </LumexNavbarContent>
</LumexNavbar>