@using Congratulator.SharedKernel.Contracts.Enums
@using Congratulator.WebAssembly.Components.PersonDetails
@using LumexUI.Common
@inject IJSRuntime Js

<LumexModal Size="ModalSize.Large" @ref="@_modal" Class="person-modal">
    <LumexModalContent>
        <div class="modal-body-background" style="--relationship-color: var(@GetRelationshipColorVar());">
            <LumexModalBody>
                <div @ref="@_bodyRef">
                    @if (_person != null)
                    {
                        <PersonDetails Person="@_person"/>
                    }
                </div>
            </LumexModalBody>
        </div>
    </LumexModalContent>
</LumexModal>

@code {
    private LumexModal _modal = null!;
    private ElementReference _bodyRef;
    private PersonModel? _person;

    public async Task Open(PersonModel person)
    {
        _person = person;
        StateHasChanged();
        await _modal.OpenAsync();

        if (person.DaysUntilBirthday == 0)
            await Js.InvokeVoidAsync("fallingConfetti", _bodyRef);
    }

    private string GetRelationshipColorVar() => _person?.RelationshipType switch
    {
        RelationshipType.Family => "--lumex-warning",
        RelationshipType.Friend => "--lumex-success",
        RelationshipType.Mate => "--lumex-secondary",
        RelationshipType.Coworker => "--lumex-primary",
        _ => "--lumex-default"
    };

}