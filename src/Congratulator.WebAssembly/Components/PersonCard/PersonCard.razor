@using System.Globalization
@using LumexUI.Common

@inherits BasePageComponent

<div class="card">
    <LumexCard>
        <div class="card-content">
            <div class="header">
                <div class="card-avatar">
                    <LumexAvatar Src="@Person.PhotoPath"
                                 Size="Size.Small"
                                 Bordered="@true"
                                 Color="@GetRelationshipColor(Person.RelationshipType)"/>
                </div>
                <div class="name">
                    <span class="name-card-cell">@Person.FirstName @Person.LastName</span>
                    <LumexChip Size="Size.Small"
                               Color="@GetRelationshipColor(Person.RelationshipType)"
                               Variant="ChipVariant.Flat">
                        @Person.RelationshipType
                    </LumexChip>
                </div>
                <div class="counter">
                    <LumexButton Disabled="@true"
                                 Variant="@(Person.DaysUntilBirthday < 1 ? Variant.Solid : Variant.Flat)">
                        @if (Person.DaysUntilBirthday < 1)
                        {
                            <span>Today</span>
                        }
                        else
                        {
                            <div class="counter-content">
                                <span>@Person.DaysUntilBirthday</span>
                                <span>@(Person.DaysUntilBirthday < 2 ? "DAY" : "DAYS")</span>
                            </div>
                        }
                    </LumexButton>
                </div>
            </div>

            <LumexDivider></LumexDivider>

            <div class="footer">
                <div class="date">
                    <i class="ri-cake-line color-grey"></i>
                    <span>@Person.BirthDate.ToString("M", CultureInfo.InvariantCulture)</span>
                </div>
                <div class="age">
                    @* example: turns 20 *@
                    <span class="color-grey">turns</span>
                    <span style="font-weight: var(--font-weight-bold)">@(Person.Age + 1)</span>
                </div>
            </div>
        </div>
    </LumexCard>
</div>