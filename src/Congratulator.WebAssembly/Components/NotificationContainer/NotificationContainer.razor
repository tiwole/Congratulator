@using Congratulator.SharedKernel.Contracts.Enums
@if (_notifications.Count > 0)
{
    <div class="notification-container">
        @foreach (var notification in _notifications)
        {
            var statusClass = notification.Status switch
            {
                NotificationStatus.Success => "notification-success",
                NotificationStatus.Warning => "notification-warning",
                NotificationStatus.Destructive => "notification-destructive",
                _ => "notification-info"
            };

            var sizeClass = notification.Size == ElementSize.Small
                ? "notification-small"
                : "notification-medium";

            <div class="notification @statusClass @sizeClass" @key="notification.Id">
                @if (notification.ShowLeadIcon)
                {
                    <i class="notification-icon @GetIconClass(notification.Status)"></i>
                }

                <div class="notification-content">
                    @if (!string.IsNullOrWhiteSpace(notification.Title))
                    {
                        <span class="notification-title">@notification.Title</span>
                    }
                    @if (notification.Size == ElementSize.Medium && !string.IsNullOrWhiteSpace(notification.Description))
                    {
                        <span class="notification-description">@notification.Description</span>
                    }
                </div>

                @if (notification.ShowCloseButton)
                {
                    <button class="notification-close" @onclick="() => RemoveNotification(notification)">
                        <i class="ri-close-line"></i>
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private static string GetIconClass(NotificationStatus status) => status switch
    {
        NotificationStatus.Success => "ri-checkbox-circle-fill",
        NotificationStatus.Warning => "ri-alert-fill",
        NotificationStatus.Destructive => "ri-error-warning-fill",
        _ => "ri-information-fill"
    };
}