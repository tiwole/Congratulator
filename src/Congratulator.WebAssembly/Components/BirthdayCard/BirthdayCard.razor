<div class="birthday-card">
    <div class="photo-container">
        <img src="@Person.PhotoPath" alt="@($"{Person.FirstName} {Person.LastName}")" class="photo" />
    </div>
    
    <div class="card-content">
        <h3 class="full-name">@($"{Person.FirstName} {Person.LastName}")</h3>
        
        <div class="info-row">
            <span class="label">Age:</span>
            <span class="value">@Person.Age @GetAgeWord(Person.Age)</span>
        </div>
        
        <div class="info-row">
            <span class="label">Birth date:</span>
            <span class="value">
                @Person.BirthDate.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.CreateSpecificCulture("en-US"))
            </span>
        </div>
        
        <div class="birthday-status @GetStatusClass()">
            @if (Person.DaysUntilBirthday == 0)
            {
                <span class="today">Today is the birthday!</span>
            }
            else
            {
                <span>Days until birthday: <strong>@Person.DaysUntilBirthday @GetDaysWord(Person.DaysUntilBirthday)</strong></span>
            }
        </div>
    </div>
</div>